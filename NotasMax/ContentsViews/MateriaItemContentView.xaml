<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.ContentsViews.MateriaItemContentView">
    <Grid>
        <Border Style="{StaticResource BorderShadow}">
            <Grid ColumnDefinitions="*,45" 
                  ColumnSpacing="8">
                <Label x:Name="label_nome_simulado"
                       FontFamily="Inter"
                       FontSize="16"                                   
                       Text="Simulado 1"      
                       Grid.Column="0"/>
                <Label x:Name="label_valor_nota"
                       FontFamily="Inter"
                       FontSize="16"
                       FontAttributes="Bold"
                       Text="0,00"                       
                       Grid.Column="1"/>
            </Grid>
        </Border>
    </Grid>
</ContentView>
