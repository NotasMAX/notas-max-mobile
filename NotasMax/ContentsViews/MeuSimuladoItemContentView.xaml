<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.ContentsViews.MeuSimuladoItemContentView">
    <Grid>
        <Border Style="{StaticResource BorderShadow}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="Button_Tapped" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" 
                  ColumnSpacing="12">
                <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center">
                    <Border x:Name="border_icon" 
                        Padding="10"
                            BackgroundColor="#e7ecf4"
                            Stroke="Transparent">
                        <Image x:Name="image_icon"
                               Style="{StaticResource ImageIcon}"
                               Source="done.png"/>
                    </Border>
                </HorizontalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label x:Name="label_numero_simulado"
                           FontFamily="Inter"
                           FontAttributes="Bold"
                           FontSize="18"
                           Text="Simulado 1"/>
                    <Label x:Name="label_data_realizacao"
                           Text="10 de fevereiro de 2026"
                           FontFamily="Inter"
                           TextColor="{StaticResource SecondaryDarkText}"
                           FontSize="14"/>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="container_media" Grid.Column="2" Spacing="2">
                    <Label x:Name="label_valor_media" 
                           Text="0,00"
                           FontFamily="Inter"
                           FontAttributes="Bold"
                           FontSize="18"
                           HorizontalTextAlignment="Center"/>
                    <Label 
                           FontFamily="Inter"
                           TextColor="{StaticResource SecondaryDarkText}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           Text="média"/>
                </VerticalStackLayout>
                <Image x:Name="image_arrow"
                       Style="{StaticResource ImageIcon}"
                       Source="arrow_right.png"
                       Grid.Column="3"/>
            </Grid>
        </Border>
    </Grid>
</ContentView>
