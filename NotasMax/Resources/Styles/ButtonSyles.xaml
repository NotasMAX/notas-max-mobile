<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.Resources.Styles.ButtonSyles">
    
    <!-- Botao com gradiente azul -->
    <LinearGradientBrush x:Key="GradientBluePrimary" EndPoint="1,0">
        <GradientStop Color="{StaticResource Blue900}" Offset="0.1"/>
        <GradientStop Color="{StaticResource Blue600}" Offset="1.0"/>
    </LinearGradientBrush>

    <Style x:Key="BtnGradientPrimary" TargetType="Button">
        <Setter Property="TextColor"      Value="White"/>
        <Setter Property="FontAttributes" Value="Bold"/>
        <Setter Property="Background"     Value="{StaticResource GradientBluePrimary}"/>
    </Style>
    <!-- Fim botao com gradiente azul -->
    
</ResourceDictionary>