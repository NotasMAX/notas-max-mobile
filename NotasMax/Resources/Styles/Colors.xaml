<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta de cores -->
    <Color x:Key="BluePrimary">#044D95</Color>
    <Color x:Key="BluePrimaryDark">#033363</Color>
    <Color x:Key="BluePrimaryLight">#1685F3</Color>
    <Color x:Key="BlueSecondary">#BAD9F7</Color>
    
    <Color x:Key="PrimaryDarkText">#132639</Color>
    <Color x:Key="SecondaryDarkText">#6C8093</Color>

    <Color x:Key="PrimaryTextLink">#1A8CFF</Color>

    <Color x:Key="YellowPrimary">#FFBB0F</Color>
    <Color x:Key="YellowSecudary">#FFE999</Color>

    <Color x:Key="GreenPrimary">#2EB867</Color>
    <Color x:Key="GreenSecudary">#2EB867</Color>

    <Color x:Key="RedPrimary">#EF4343</Color>

    <Color x:Key="Blue100">#E6F0FA</Color>
    <Color x:Key="Blue200">#BFD8F4</Color>
    <Color x:Key="Blue300">#99C1EE</Color>
    <Color x:Key="Blue400">#5A95E0</Color>
    <Color x:Key="Blue500">#2F7DD3</Color>
    <Color x:Key="Blue600">#106BC6</Color>
    <Color x:Key="Blue700">#0D5AA8</Color>
    <Color x:Key="Blue800">#094A8A</Color>
    <Color x:Key="Blue900">#053A6F</Color>

    <Color x:Key="BlueGray100">#F4F7FA</Color>
    <Color x:Key="BlueGray200">#E0E6EB</Color>
    <Color x:Key="BlueGray300">#C9D2D9</Color>
    <Color x:Key="BlueGray400">#AEBBC4</Color>
    <Color x:Key="BlueGray500">#94A3AF</Color>
    <Color x:Key="BlueGray600">#7A8A99</Color>
    <Color x:Key="BlueGray700">#5F6D7A</Color>
    <Color x:Key="BlueGray800">#44505A</Color>
    <Color x:Key="BlueGray900">#2A333A</Color>

    <Color x:Key="SurfaceInput">#F1F3F6</Color>
    <Color x:Key="BackgroundColor">#F6F7F9</Color>

    <!-- Paleta de cores predefinidas automaticamente pelo VS -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource BluePrimary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource BlueSecondary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
    
</ResourceDictionary>