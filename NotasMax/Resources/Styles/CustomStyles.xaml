<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.Resources.Styles.CustomStyles">

    <Style TargetType="Border" x:Key="BorderShadow">
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="Background" Value="{StaticResource White}" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Shadow">
            <Setter.Value>
                <Shadow Brush="Black"
                    Offset="0,2"
                    Radius="12"
                    Opacity="0.08" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="VerticalStackLayout" x:Key="VerStackInsight">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style TargetType="Label" x:Key="LabelTitle">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold"/>
    </Style>
    <Style TargetType="Label" x:Key="LabelDetails">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}"/>
    </Style>
    <Style TargetType="Label" x:Key="LabelInsightValue">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Label" x:Key="LabelInsightText">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
    <Style TargetType="Image" x:Key="ImageIcon">
        <Setter Property="HeightRequest" Value="25" />
        <Setter Property="WidthRequest" Value="25" />
    </Style>
    <Style TargetType="Label" x:Key="LabelSubtitle">
        <Setter Property="FontFamily" Value="SpaceGrotesk" />
        <Setter Property="FontSize" Value="18" />
    </Style>
    <Style TargetType="Label" x:Key="LabelButton">
        <Setter Property="FontFamily" Value="Inter" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>