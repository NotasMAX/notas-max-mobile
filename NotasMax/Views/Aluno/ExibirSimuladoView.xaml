<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cv="clr-namespace:NotasMax.ContentsViews"
             xmlns:chart="http://schemas.syncfusion.com/maui/toolkit"
             x:Class="NotasMax.Views.Aluno.ExibirSimuladoView">
    <ScrollView BackgroundColor="{StaticResource BackgroundColor}">
        <VerticalStackLayout Spacing="20" Margin="25,40">
            <VerticalStackLayout Spacing="4" >
                <Label Style="{StaticResource LabelTitle}"   
                       Text="Simulado"
                       x:Name="label_simulado"/>
                <Label  Style="{StaticResource LabelDetails}"         
                        Text="Data de realização"
                        x:Name="label_data_realizacao"/>
            </VerticalStackLayout>
            <VerticalStackLayout>
                <Border Style="{StaticResource BorderShadow}"  Background="{StaticResource GradientBluePrimary}">
                    <VerticalStackLayout Style="{StaticResource VerStackInsight}">
                        <Label Text="Média"
                           Opacity="0.8"
                           FontFamily="Inter"
                           HorizontalOptions="Center"
                           TextColor="White"
                           FontSize="16"/>
                        <Label Style="{StaticResource LabelInsightValue}" 
                           TextColor="White"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"
                           FontSize="30"
                           x:Name="label_valor_media"
                           Text="0.00"/>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource BorderShadow}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource LabelSubtitle}"
                         Text="Notas por Disciplina"/>
                        <chart:SfCartesianChart IsTransposed="True">
                            <chart:SfCartesianChart.XAxes>
                                <chart:CategoryAxis>
                                    <chart:CategoryAxis.LabelStyle>
                                        <chart:ChartAxisLabelStyle 
                                      FontSize="10"  
                                      FontFamily="Inter"/>
                                    </chart:CategoryAxis.LabelStyle>
                                </chart:CategoryAxis>
                            </chart:SfCartesianChart.XAxes>
                            <chart:SfCartesianChart.YAxes>
                                <chart:NumericalAxis
                              Minimum="0"
                              Maximum="10"
                              Interval="1"/>
                            </chart:SfCartesianChart.YAxes>
                            <chart:ColumnSeries 
                          x:Name="column_chart"
                          XBindingPath="Nome"
                          YBindingPath="Nota"
                          Fill="#044D95"                 
                          StrokeWidth="3"/>
                        </chart:SfCartesianChart>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="16">
                <Border Style="{StaticResource BorderShadow}">
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource LabelSubtitle}"
                        Text="Comparativo por Matérias"/>
                        <chart:SfPolarChart StartAngle="Rotate0" 
                                     GridLineType="Polygon" 
                                     HeightRequest="250">
                            <chart:SfPolarChart.PrimaryAxis>
                                <chart:CategoryAxis/>
                            </chart:SfPolarChart.PrimaryAxis>

                            <chart:SfPolarChart.SecondaryAxis>
                                <chart:NumericalAxis Minimum="0"
                                              Maximum="10"
                                              Interval="4"
                                              />
                            </chart:SfPolarChart.SecondaryAxis>

                            <chart:PolarAreaSeries 
                         x:Name="polar_line_chart"
                         XBindingPath="Nome" 
                         YBindingPath="Nota"
                         Fill="#f7d588"
                         Stroke="#FFBB0F"
                         Opacity="0.5"
                         StrokeWidth="3"/>
                        </chart:SfPolarChart>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
            <VerticalStackLayout Spacing="12">
                <Label Style="{StaticResource LabelSubtitle}" 
                   FontAttributes="Bold"
                   Text="Histórico de Notas"/>
                <VerticalStackLayout x:Name="layout_disciplinas" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate >
                            <cv:ExibirSimuladoItemContentView/>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>