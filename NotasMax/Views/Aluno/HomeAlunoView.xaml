<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:NotasMax.Models.Simulados"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="NotasMax.Views.Aluno.HomeAlunoView"
             x:Name="thisPage">
    
    <ScrollView>
        <VerticalStackLayout Padding="20,40" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">

                <VerticalStackLayout Grid.Column="0" Spacing="2">

                    <Label Text="Olá,"
                           Style="{StaticResource LabelDefaultSecudary}"/>

                    <HorizontalStackLayout Spacing="6">

                        <Label x:Name="txt_nomeUsuario"
                               Style="{StaticResource LabelDefaultTitle}"
                               FontSize="26"
                               TextColor="#1A1F36" />
                        <Label Text="👋"
                               FontSize="26"
                               VerticalOptions="Center" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>

                <!-- Avatar -->
                <Button Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        Background="{StaticResource GradientBluePrimary}"
                        VerticalOptions="Center" 
                        x:Name="txt_inicialUsuario"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White" 
                        CornerRadius="50"
                        Clicked="Avatar_Clicked"/>
            </Grid>

            <!-- Card: Nota Geral -->
            <Border StrokeThickness="0"
                    Padding="20,18"
                    Background="{StaticResource GradientBluePrimary}"
                    StrokeShape="RoundRectangle 20">


                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="MÉDIA GERAL"
                               Style="{StaticResource LabelDefault}" 
                               TextColor="{StaticResource Blue200}"/>
                        <Label x:Name="txt_notaGeral" 
                               Style="{StaticResource LabelDefaultTitle}"
                               FontSize="48"
                               TextColor="White"
                               LineHeight="1" />
                    </VerticalStackLayout>

                    <!-- Ícone de tendência -->
                    <Border Grid.Column="1"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeThickness="1"
                            BackgroundColor="Transparent"
                            VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="26" />
                        </Border.StrokeShape>

                        <Image x:Name="img_seta"
                               Source="seta_subindo_desempenho.png" 
                               Aspect="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Cards: Últimos e Próximos Simulado -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <!-- Último Simulado -->
                <Border Grid.Column="0"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="14,12" >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,3"
                                Radius="12"
                                Opacity="0.15" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource Blue200}"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="📖"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Último"
                                   Style="{StaticResource LabelDefault}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="txt_ultimoSimulado" 
                               Text="Sim. 1 – 10 de Fev"
                               Style="{StaticResource LabelDefaultBold}"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Proximo Simulado -->
                <Border Grid.Column="1"
                        StrokeThickness="0"
                        BackgroundColor="White"
                        Padding="14,12" >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Offset="0,3"
                                Radius="12"
                                Opacity="0.15" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="6">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Border WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource YellowSecudary}"
                                    StrokeShape="RoundRectangle 8">
                                <Label Text="📘"
                                       FontSize="16"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            <Label Text="Último"
                                   Style="{StaticResource LabelDefault}"
                                   FontSize="12"
                                   TextColor="{StaticResource Gray300}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label x:Name="txt_proximoSimulado" 
                               Text="Sim. 2 – 30 de Mar"
                               Style="{StaticResource LabelDefaultBold}"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Card: Evolução da Nota -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="18,16">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <Border.Shadow>
                    <Shadow Brush="#000000"
                            Offset="0,3"
                            Radius="12"
                            Opacity="0.15" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">

                    <!-- Título + Seletor de Bimestre -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Grid.Column="0"
                                Text="Evolução da Nota"
                                Style="{StaticResource LabelDefaultTitle}" />

                        <!-- Picker de Bimestre -->
                        <Picker x:Name="picker_bimestre"
                                Grid.Column="1"
                                WidthRequest="120"
                                SelectedIndexChanged="Picker_Bimestre_Changed"
                                TextColor="{StaticResource Blue600}"
                                FontSize="13"/>

                    </Grid>

                    <!-- Gráfico de Linha -->
                    <chart:SfCartesianChart x:Name="grafico_evolucao"
                                             HeightRequest="180"
                                             BackgroundColor="Transparent">

                        <chart:SfCartesianChart.XAxes>
                            
                            <chart:CategoryAxis ShowMajorGridLines="False"
                                                EdgeLabelsDrawingMode="Center">
                                
                                <chart:CategoryAxis.LabelStyle>
                                
                                    <chart:ChartAxisLabelStyle TextColor="Gray" FontSize="11"/>
                                    
                                </chart:CategoryAxis.LabelStyle>
                                
                            </chart:CategoryAxis>
                            
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            <chart:NumericalAxis Minimum="0"
                                                Maximum="11"
                                                Interval="2"
                                                ShowMajorGridLines="True">
                                
                                <chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:ChartLineStyle Stroke="#E2E8F0" StrokeWidth="1"/>
                                </chart:NumericalAxis.MajorGridLineStyle>
                                
                                <chart:NumericalAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle TextColor="Gray" FontSize="11"/>
                                </chart:NumericalAxis.LabelStyle>
                                
                            </chart:NumericalAxis>
                            
                        </chart:SfCartesianChart.YAxes>

                        <chart:LineSeries x:Name="serie_evolucao"
                                           XBindingPath="Label"
                                           YBindingPath="Media"
                                           Fill="{StaticResource Blue500}"
                                           StrokeWidth="2.5"
                                           ShowMarkers="True">     
                            
                            <chart:LineSeries.MarkerSettings>
                                
                                <chart:ChartMarkerSettings Type="Circle"
                                    Fill="{StaticResource Blue900}"
                                    Stroke="White"
                                    StrokeWidth="1.5"
                                    Width="8"
                                    Height="8"/>
                                
                            </chart:LineSeries.MarkerSettings>
                        </chart:LineSeries>

                    </chart:SfCartesianChart>

                </VerticalStackLayout>
            </Border>

            <!-- Seção: Notas por Matéria -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                <Label Grid.Column="0"
                       Text="Notas por Matéria"
                       Style="{StaticResource LabelDefaultTitle}"
                       VerticalOptions="Center" />

                <Label Grid.Column="1" Style="{StaticResource LabelDefaultLink}"
                       TextDecorations="None"
                       Text="Ver Tudo"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLabelVerTudoMateria" />
                    </Label.GestureRecognizers>
                    
                </Label>
                
            </Grid>

            <!-- Card: Lista de Matérias -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="4,8">
                
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>

                <CollectionView x:Name="collection_materias">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                    
                    <CollectionView.ItemTemplate>

                        <DataTemplate x:DataType="models:MediaMateriaSimulado">

                            <Border Background="White"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="1.5"
                                    Stroke="{StaticResource Blue300}">

                                <Grid Padding="14,14"
                                      ColumnDefinitions="Auto,*,Auto,Auto"
                                      ColumnSpacing="10"
                                      Background="White"
                                      VerticalOptions="Center">

                                    <!-- Ícone -->
                                    <Border Grid.Column="0"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            StrokeThickness="0"
                                            BackgroundColor="{StaticResource Blue300}"
                                            Padding="5">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>

                                        <Label Text="📚"
                                               FontSize="18"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>

                                    </Border>

                                    <!-- Nome da Matéria + ProgressBar -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding Materia}"
                                               Style="{StaticResource LabelDefault}"/>

                                        <Label Text="{Binding Professor}"
                                               FontSize="11"
                                               TextColor="Gray"/>

                                        <progressBar:SfLinearProgressBar Progress="{Binding Media, Converter={x:Reference thisPage}}"
                                                                         TrackFill="#E2E8F0" 
                                                                         ProgressFill="{StaticResource BluePrimaryLight}"/>
                                    </VerticalStackLayout>

                                    <!-- Nota -->
                                    <Label Grid.Column="2"
                                           Text="{Binding Media, StringFormat='{0:F1}'}"
                                           Style="{StaticResource LabelDefault}"
                                           VerticalOptions="Center"/>

                                    <!-- Seta -->
                                    <Border Grid.Column="3" StrokeThickness="0">

                                        <Image Source="arrow_right.png"
                                               Aspect="Center"
                                               VerticalOptions="Center">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_VerMateria"
                                                                      CommandParameter="{Binding MateriaId}" />
                                            </Image.GestureRecognizers>
                                        </Image>

                                    </Border>

                                </Grid>

                            </Border>

                        </DataTemplate>
                        
                    </CollectionView.ItemTemplate>
                    
                </CollectionView>

            </Border>

        </VerticalStackLayout>
        
    </ScrollView>

</ContentPage> 