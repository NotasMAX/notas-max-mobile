<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.Views.Aluno.MinhasMateriasView"
             Title="">

    <ScrollView BackgroundColor="{StaticResource BackgroundColor}">
        <VerticalStackLayout Spacing="20" Margin="25,40">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Minhas matérias"
                       Style="{StaticResource LabelTitle}" />
                <Label Text="Abaixo estão listadas todas as matérias"
                       Style="{StaticResource LabelDetails}" />
            </VerticalStackLayout>

            <!-- Grid de cards de matérias gerado dinamicamente -->
            <Grid x:Name="grid_materias"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12"
                  RowSpacing="12" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
