<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.Views.LoginPage">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style TargetType="Border" x:Key="BorderLoginTop">
                <Setter Property="Stroke" Value="Transparent" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
                <Setter Property="Background" Value="{StaticResource BluePrimary}" />
                <Setter Property="HeightRequest" Value="100" />
                <Setter Property="WidthRequest" Value="100" />
                <Setter Property="Margin" Value="0,44,0,0" />
                <Setter Property="Padding" Value="4,4" />
            </Style>

            <Style TargetType="Border" x:Key="BorderLoginBotton">
                <Setter Property="Grid.Row" Value="1" />
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Stroke" Value="White" />
                <Setter Property="StrokeThickness" Value="4" />
                <Setter Property="StrokeShape" Value="RoundRectangle 20,20,0,0" />
                <Setter Property="Background" Value="White" />
                <Setter Property="Padding" Value="16,8" />
            </Style>
            
            <Style x:Key="LabelFieldDefault" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="{StaticResource SecondaryDarkText}"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
            </Style>

            <Style x:Key="EntryFieldDefault" TargetType="Entry">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor" Value="{StaticResource Gray900}"/>
                <Setter Property="PlaceholderColor" Value="{StaticResource BlueGray700}"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="VerticalOptions" Value="Center"/>
            </Style>

            <Style x:Key="BorderFieldDefault" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceInput}"/>
                <Setter Property="Stroke" Value="{StaticResource Gray100}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="14,0"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 10"/>
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>
    
    
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="1,0">
            <GradientStop Color="{StaticResource Blue900}"
                          Offset="0.1" />
            <GradientStop Color="{StaticResource Blue600}"
                          Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    
    <Grid RowDefinitions="250, *" ColumnDefinitions="*">
        
        <VerticalStackLayout  Grid.Row="0" Grid.Column="0" Spacing="4">
            
            <Border Style="{StaticResource BorderLoginTop}">
                
                <Image Source="logo.png"
                       Aspect="AspectFit" />
                
            </Border>
            
            <Label Style="{StaticResource LabelDefaultBold}"
                   FontFamily="SpaceGrotesk"
                   TextColor="White"
                   TextTransform="Uppercase"
                   HorizontalTextAlignment="Center"
                   FontSize="24">NOTASMAX</Label>
            
            <Label Style="{StaticResource LabelDefault}"
                   TextColor="White"
                   HorizontalTextAlignment="Center">
                Acompanhe seu desempenho escolar
            </Label>
        </VerticalStackLayout>
        
        <Border Style="{StaticResource BorderLoginBotton}">
            
            <VerticalStackLayout Spacing="16" Padding="8,16">
                
                <VerticalStackLayout Spacing="4">

                    <Label Style="{StaticResource LabelDefaultBold}"
                       FontFamily="SpaceGrotesk"                     
                       Text="Bem-Vindo de volta!"
                       FontSize="20"/>

                    <Label Style="{StaticResource LabelDefault}"
                        TextColor="{StaticResource SecondaryDarkText}"
                        Text="Entre para ver suas notas e simulados"/>
                    
                </VerticalStackLayout>
                
                <VerticalStackLayout Spacing="8">

                    <Label Style="{StaticResource LabelFieldDefault}"
                           Text="E-mail:"/>
                    <Border Style="{StaticResource BorderFieldDefault}">
                        <Entry Style="{StaticResource EntryFieldDefault}"
                               x:Name="entry_email"
                               Placeholder="seu@email.com"/>
                    </Border>
                    
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">

                    <Label Style="{StaticResource LabelFieldDefault}"
                           Text="Senha:"/>
                    <Border Style="{StaticResource BorderFieldDefault}">
                        <Entry Style="{StaticResource EntryFieldDefault}"
                               x:Name="entry_senha"
                               IsPassword="True"
                               Placeholder="******"/>
                    </Border>

                </VerticalStackLayout>

                <Label Style="{StaticResource LabelDefaultLink}"
                    Text="Esqueceu a senha?">

                    <Label.GestureRecognizers>
                        
                        <TapGestureRecognizer Tapped="OnLabelEsqueceuSenhaTapped" 
                              Command="{Binding YourCommand}" />
                    </Label.GestureRecognizers>
                    
                </Label>

                <Button Style="{StaticResource BtnGradientPrimary}"
                        x:Name="button_entrar"
                        Text="Entrar"
                        Clicked="ButtonEntrarClicked"/>

            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>