<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="NotasMax.Views.Professor.HomeProfessorView"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:effects="clr-namespace:Syncfusion.Maui.Toolkit.EffectsView;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Toolkit.Charts;assembly=Syncfusion.Maui.Toolkit"
             xmlns:models="clr-namespace:NotasMax.Models.Simulados">

    <ScrollView>

        <VerticalStackLayout Padding="20,40" Spacing="16">

            <!-- Header -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">

                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Olá,"
                           Style="{StaticResource LabelDefaultSecudary}"/>
                    <HorizontalStackLayout Spacing="6">
                        <Label x:Name="txt_nomeUsuario"
                               Style="{StaticResource LabelDefaultTitle}"
                               FontSize="26"
                               TextColor="#1A1F36" />
                        <Label Text="👋"
                               FontSize="26"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Avatar -->
                <Button Grid.Column="1"
                        WidthRequest="44"
                        HeightRequest="44"
                        Background="{StaticResource GradientBluePrimary}"
                        VerticalOptions="Center"
                        x:Name="txt_inicialUsuario"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="White"
                        CornerRadius="50"
                        Clicked="Avatar_Clicked"/>
            </Grid>

            <!-- Cards de Insights: Turmas e Simulados -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                <!-- Turmas -->
                <Border Grid.Column="0" Style="{StaticResource BorderShadow}" Padding="12">
                    <VerticalStackLayout Style="{StaticResource VerStackInsight}">
                        <Image Source="turmas.png" Style="{StaticResource ImageIcon}" />
                        <Label x:Name="txt_totalTurmas"
                               Text="-"
                               Style="{StaticResource LabelInsightValue}"
                               TextColor="{StaticResource BluePrimary}" />
                        <Label Text="Turmas" Style="{StaticResource LabelInsightText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Simulados -->
                <Border Grid.Column="1" Style="{StaticResource BorderShadow}" Padding="12">
                    <VerticalStackLayout Style="{StaticResource VerStackInsight}">
                        <Image Source="simulados.png" Style="{StaticResource ImageIcon}" />
                        <Label x:Name="txt_totalSimulados"
                               Text="-"
                               Style="{StaticResource LabelInsightValue}"
                               TextColor="{StaticResource YellowPrimary}" />
                        <Label Text="Simulados" Style="{StaticResource LabelInsightText}" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Card Média Geral das Turmas -->
            <Border StrokeThickness="0"
                    Padding="20,18"
                    Background="{StaticResource GradientBluePrimary}"
                    StrokeShape="RoundRectangle 20">

                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                        <Label Text="MÉDIA GERAL DAS TURMAS"
                               Style="{StaticResource LabelDefault}"
                               TextColor="{StaticResource Blue200}"/>
                        <Label x:Name="txt_notaGeral"
                               Text="-"
                               Style="{StaticResource LabelDefaultTitle}"
                               FontSize="48"
                               TextColor="White"
                               LineHeight="1" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            WidthRequest="52"
                            HeightRequest="52"
                            StrokeShape="Ellipse"
                            BackgroundColor="#33FFFFFF"
                            Stroke="Transparent"
                            VerticalOptions="Center">
                        <Image x:Name="img_seta"
                               Source="seta_subindo_desempenho.png"
                               Aspect="Center"/>
                    </Border>
                </Grid>

            </Border>

            <!-- Card Gráfico Média por Turma -->
            <Border Style="{StaticResource BorderShadow}">

                <VerticalStackLayout Spacing="12">

                    <!-- Título + Filtro de Ano -->
                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0"
                               Text="Média por Turma"
                               Style="{StaticResource LabelSubtitle}"
                               FontSize="16"
                               VerticalOptions="Center" />  

                        <Picker x:Name="picker_ano"
                                Grid.Column="1"
                                WidthRequest="100"
                                TextColor="{StaticResource Blue600}"
                                FontSize="13"
                                SelectedIndexChanged="Picker_Ano_Changed" />

                    </Grid>

                    <!-- Gráfico de Barras -->
                    <chart:SfCartesianChart x:Name="grafico_turmas"
                                            HeightRequest="200"
                                            BackgroundColor="Transparent">

                        <chart:SfCartesianChart.XAxes>
                            <chart:CategoryAxis ShowMajorGridLines="False"
                                                EdgeLabelsDrawingMode="Center">
                                
                                <chart:CategoryAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle TextColor="Gray" FontSize="11" />
                                </chart:CategoryAxis.LabelStyle>
                                
                            </chart:CategoryAxis>
                            
                        </chart:SfCartesianChart.XAxes>

                        <chart:SfCartesianChart.YAxes>
                            
                            <chart:NumericalAxis Minimum="0"
                                                 Maximum="10"
                                                 Interval="2"
                                                 ShowMajorGridLines="True"> 
                                
                                <chart:NumericalAxis.MajorGridLineStyle>
                                    <chart:ChartLineStyle Stroke="#E2E8F0" StrokeWidth="1" />
                                </chart:NumericalAxis.MajorGridLineStyle>
                                
                                <chart:NumericalAxis.LabelStyle>
                                    <chart:ChartAxisLabelStyle TextColor="Gray" FontSize="11" />
                                </chart:NumericalAxis.LabelStyle>
                                
                            </chart:NumericalAxis>
                            
                        </chart:SfCartesianChart.YAxes>

                        <chart:ColumnSeries x:Name="serie_turmas"
                                            XBindingPath="SerieAno"
                                            YBindingPath="MediaGeralTurma"
                                            Fill="{StaticResource BluePrimary}"
                                            Width="0.5"
                                            Spacing="0.2"
                                            ShowDataLabels="True"
                                            EnableTooltip="True">

                            <chart:ColumnSeries.DataLabelSettings>
                                
                                <chart:CartesianDataLabelSettings>
                                    
                                    <chart:CartesianDataLabelSettings.LabelStyle>
                                        
                                        <chart:ChartDataLabelStyle TextColor="{StaticResource BluePrimary}"
                                                       FontSize="11"
                                                       FontAttributes="Bold" />
                                    </chart:CartesianDataLabelSettings.LabelStyle>
                                    
                                </chart:CartesianDataLabelSettings>
                                
                            </chart:ColumnSeries.DataLabelSettings>

                        </chart:ColumnSeries>

                    </chart:SfCartesianChart>

                    <!-- Estado vazio -->
                    <Label x:Name="lbl_grafico_vazio"
                           Text="Nenhuma turma encontrada para este ano."
                           Style="{StaticResource LabelDetails}"
                           HorizontalOptions="Center"
                           IsVisible="False" />

                </VerticalStackLayout>

            </Border>
            <!-- Seção: Suas Turmas -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,4,0,0">
                <Label Grid.Column="0"
                       Text="Suas Turmas"
                       Style="{StaticResource LabelDefaultTitle}"
                       VerticalOptions="Center" />
                
                <Label Grid.Column="1"
                       Style="{StaticResource LabelDefaultLink}"
                       TextDecorations="None"
                       Text="Ver Tudo"
                       VerticalOptions="Center">
                    
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLabelVerTudoTurmas" />
                    </Label.GestureRecognizers>
                    
                </Label>
                
            </Grid>

            <!-- Lista de Turmas -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="4,8"
                    StrokeShape="RoundRectangle 20">

                <CollectionView x:Name="collection_materias">

                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TurmaResumo">

                            <effects:SfEffectsView TouchDownEffects="Ripple"
                               RippleBackground="{StaticResource Blue200}">
                                
                                <effects:SfEffectsView.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_VerTurma"
                                                          CommandParameter="{Binding TurmaId}" />
                                </effects:SfEffectsView.GestureRecognizers>
                                
                                <Border Style="{StaticResource BorderShadow}" Padding="12,14">

                                    <Grid ColumnDefinitions="Auto, *, Auto, Auto">

                                        <!-- Ícone da turma -->
                                        <Border Grid.Column="0"
                                                WidthRequest="40" HeightRequest="40"
                                                StrokeShape="RoundRectangle 10"
                                                BackgroundColor="{StaticResource Blue100}"
                                                Stroke="Transparent"
                                                Margin="0,0,12,0">
                                            <Image Source="turmas.png"
                                                   HeightRequest="22" WidthRequest="22"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <!-- Nome da turma + total de alunos -->
                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding SerieAno}"
                                                   Style="{StaticResource LabelDefaultBold}"
                                                   FontSize="15" />
                                            <Label Text="{Binding TotalAlunosFormatado}"
                                                   Style="{StaticResource LabelDetails}"
                                                   FontSize="13" />
                                        </VerticalStackLayout>

                                        <!-- Média geral da turma -->
                                        <Label Grid.Column="2"
                                               Text="{Binding MediaGeralTurma, StringFormat='{0:F1}'}"
                                               Style="{StaticResource LabelDefaultBold}"
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               Margin="0,0,8,0" />

                                        <!-- Seta -->
                                        <Label Grid.Column="3"
                                               Text="›"
                                               TextColor="{StaticResource BlueGray400}"
                                               FontSize="20"
                                               VerticalOptions="Center" />

                                    </Grid>

                                </Border>

                               </effects:SfEffectsView>
                            
                        </DataTemplate>
                        
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </Border>

            <BoxView HeightRequest="16" Color="Transparent" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>