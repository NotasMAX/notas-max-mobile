<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NotasMax.Views.Professor.TurmasView">
    <ScrollView BackgroundColor="{StaticResource BackgroundColor}">
        <VerticalStackLayout Spacing="20" Margin="25,40">
            <VerticalStackLayout Spacing="4" >
                <Label Style="{StaticResource LabelTitle}"           
                   Text="Turmas"/>
                <Label  Style="{StaticResource LabelDetails}"                        
                        Text="Gerencie suas turmas e acompanhe o desempenho"/>
            </VerticalStackLayout>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <VerticalStackLayout Grid.Column="0">
                    <Border Style="{StaticResource BorderShadow}">
                        <VerticalStackLayout Style="{StaticResource VerStackInsight}">
                            <Label Style="{StaticResource LabelInsightValue}" 
                                   TextColor="{StaticResource Blue600}"
                                   FontAttributes="Bold"
                                   FontSize="24"
                                   x:Name="label_numero_turmas_ativas"
                                   Text="0"/>
                            <Label Style="{StaticResource LabelInsightText}"
                                   Text="Turmas Ativas"
                                   FontSize="16"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Border Style="{StaticResource BorderShadow}">
                        <VerticalStackLayout Style="{StaticResource VerStackInsight}">
                            <Label Style="{StaticResource LabelInsightValue}"  
                                   x:Name="label_numero_total_alunos"
                                   TextColor="{StaticResource YellowPrimary}"
                                   FontAttributes="Bold"
                                   FontSize="24"
                                   Text="0"/>
                            <Label Style="{StaticResource LabelInsightText}"
                                   FontSize="16"
                                   Text="Total de Alunos"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </Grid>
            <Grid>
                <Border Style="{StaticResource BorderShadow}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_1" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="45,*,45,25" 
                          ColumnSpacing="12">
                        <HorizontalStackLayout Grid.Column="0">
                            <Border Padding="10"
                                    BackgroundColor="#e7ecf4"
                                    Stroke="Transparent">
                                <Image Style="{StaticResource ImageIcon}"
                                    Source="people.png"/>
                            </Border>
                        </HorizontalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label FontFamily="Inter"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   Text="1º EM"/>
                            <Label FontFamily="Inter"
                                   TextColor="{StaticResource SecondaryDarkText}"
                                   FontSize="15"
                                   Text="32 alunos"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                            <Label FontFamily="Inter"
                                   FontAttributes="Bold"
                                   FontSize="20"
                                   HorizontalTextAlignment="Center"
                                   Text="0.0"/>
                            <Label FontFamily="Inter"
                                   TextColor="{StaticResource SecondaryDarkText}"
                                   FontSize="13"
                                   HorizontalTextAlignment="Center"
                                   Text="média"/>
                        </VerticalStackLayout>
                        <Image Style="{StaticResource ImageIcon}"
                                Source="arrow_right.png"
                                Grid.Column="3"/>
                    </Grid>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>